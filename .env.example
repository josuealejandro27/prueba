# ==============================================================================
# PLANTILLA DE CONFIGURACIÓN DE VARIABLES DE ENTORNO (.env.example)
# ==============================================================================
# Copia este archivo como '.env' en la raíz del proyecto para desarrollo local:
#   PowerShell: Copy-Item .env.example .env
#
# IMPORTANTE:
# - Spring Boot carga '.env' automáticamente (spring.config.import en
#   application.properties). Las variables del sistema/entorno tienen prioridad.
# - El archivo '.env' real está excluido de Git (.gitignore) para evitar fugas.
# - NUNCA guardes credenciales de producción en este archivo de ejemplo.
# - En despliegue (ej. Render, AWS, Kubernetes), configura estas variables
#   directamente en el gestor de secretos o panel de variables de entorno.
# - Los valores de este archivo son FICTICIOS: sustitúyelos por los reales.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BASE DE DATOS PRINCIPAL (PostgreSQL)
# ------------------------------------------------------------------------------
# URL JDBC hacia PostgreSQL.
# Desarrollo local típico: jdbc:postgresql://localhost:5432/usuarios_db
# En la nube (Supabase / Render): jdbc:postgresql://<host>:<puerto>/<database>
DB_URL=jdbc:postgresql://localhost:5432/usuarios_db
DB_USERNAME=postgres_user_ejemplo
DB_PASSWORD=contrasena_segura_ejemplo
# Alternativas aceptadas por application.properties (opcionales; útiles si la
# plataforma ya las define, p. ej. Spring Boot en Render):
# SPRING_DATASOURCE_URL=jdbc:postgresql://<host>:<puerto>/<database>
# SPRING_DATASOURCE_USERNAME=usuario_ejemplo
# SPRING_DATASOURCE_PASSWORD=contrasena_ejemplo

# ------------------------------------------------------------------------------
# 2. CACHÉ DEL CATÁLOGO (MongoDB)
# ------------------------------------------------------------------------------
# URI de conexión hacia MongoDB.
# Desarrollo local típico (sin auth): mongodb://localhost:27017/catalogo_cache
# MongoDB Atlas en la nube: mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/catalogo_cache?retryWrites=true&w=majority&authSource=admin
# Si la contraseña contiene caracteres especiales (@ : / ? # & %), codifícala
# en URL (ej. & -> %26) antes de colocarla en la URI.
MONGODB_URI=mongodb://localhost:27017/catalogo_cache
MONGODB_DATABASE=catalogo_cache

# ------------------------------------------------------------------------------
# 3. SEGURIDAD Y TOKENS JWT
# ------------------------------------------------------------------------------
# Clave secreta para la firma y validación de tokens JWT (algoritmo HMAC-SHA256).
# REQUISITO CRÍTICO: Debe ser de al menos 256 bits (mínimo 32 caracteres ASCII).
# Generar una nueva (no reutilizar la de ejemplo):
#   PowerShell: [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Maximum 256 }))
#   OpenSSL:    openssl rand -base64 48
# Al cambiarla, todos los tokens emitidos con la clave anterior dejan de ser válidos.
JWT_SECRET=clave_secreta_jwt_ficticia_de_al_menos_32_caracteres_12345
# Tiempo de expiración del token en milisegundos (86400000 ms = 24 horas)
JWT_EXPIRATION=86400000

# ------------------------------------------------------------------------------
# 4. INTEGRACIÓN GESTOPAGO (Autenticación y Catálogo)
# ------------------------------------------------------------------------------
# URL base de la API de Gestopago (valor ficticio de ejemplo; sustitúyelo por la real)
GESTOPAGO_AUTH_URL=https://gestopago.example.com
# Identificador del distribuidor asignado por Gestopago (ficticio)
GESTOPAGO_DISTRIBUIDOR_ID=999
# Código del dispositivo autorizado asignado por Gestopago (ficticio)
GESTOPAGO_DISPOSITIVO_CODIGO=DEV-TPV-EJEMPLO
# Contraseña del dispositivo para generar el Bearer Token en /sistema/app/jwt-gp/authenticate/
GESTOPAGO_DISPOSITIVO_PASSWORD=contrasena_gestopago_ejemplo
# Frecuencia de renovación del token en milisegundos (3600000 ms = 1 hora)
GESTOPAGO_REFRESH_RATE_MS=3600000

# Parámetros del catálogo de productos (URL ficticia de ejemplo)
GESTOPAGO_PRODUCTOS_URL=https://gestopago.example.com
GESTOPAGO_PRODUCTOS_RUTA=/sistema/service/getProductList.do
GESTOPAGO_PRODUCTOS_CRON=0 0 6 * * *
# Token estático opcional de respaldo (normalmente se resuelve desde la BD)
GESTOPAGO_PRODUCTOS_TOKEN=

# ------------------------------------------------------------------------------
# 5. SERVIDOR Y DOCUMENTACIÓN (Opcional)
# ------------------------------------------------------------------------------
PORT=8080
# URL pública forzada para Swagger; en Render se detecta sola con RENDER_EXTERNAL_URL.
# Si se define RENDER_EXTERNAL_URL (Render la inyecta automáticamente), no hace
# falta definir OPENAPI_SERVER_URL.
OPENAPI_SERVER_URL=
OPENAPI_LOCAL_URL=http://localhost:8080
# RENDER_EXTERNAL_URL=https://tu-servicio.onrender.com

